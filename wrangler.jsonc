{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "funding-explorer",
  "account_id": "83f1f925214b589247c9cb2a1a44b18c",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "NEON_AUTH_BASE_URL": "https://ep-wild-voice-be2fq44t.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth",
    "ALLOWED_ORIGINS": "https://funding-explorer.greatlakesicorps.workers.dev,http://localhost:5173",
  },
  "durable_objects": {
    "bindings": [
      { "name": "FUNDING_RATE_LIMITER", "class_name": "FundingRateLimiter" },
    ],
  },
  "migrations": [
    {
      "tag": "funding-rate-limit-v1",
      "new_sqlite_classes": ["FundingRateLimiter"],
    },
  ],
}
