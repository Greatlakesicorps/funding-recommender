# Copy to .env.local (ignored by Git). See docs/development.md.
# All three values are required. Never commit real credentials here.

# Private Maizey project token, not a Toolkit API key.
MAIZEY_API_TOKEN=replace-with-your-maizey-api-token

# Copy the intended Neon branch's full Auth URL, including /auth.
NEON_AUTH_BASE_URL=replace-with-your-neon-auth-base-url

# Generate a random value of at least 32 characters; keep stable per environment.
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters
