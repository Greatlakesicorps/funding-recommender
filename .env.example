# Copy to .env.local (site, read by Vite) and .dev.vars (Worker, read by
# `wrangler dev`). Both are ignored by Git. Never commit real credentials.
# See docs/development.md.

# --- Site (.env.local) ---------------------------------------------------

# Full Neon Auth URL for the intended branch, including /auth.
VITE_NEON_AUTH_URL=replace-with-your-neon-auth-base-url

# Worker origin. Use the local dev Worker while running `npm run dev`.
VITE_API_URL=http://localhost:8787

# --- Worker (.dev.vars locally, `wrangler secret put` in production) -----

# Private Maizey project token, not a Toolkit API key.
MAIZEY_API_TOKEN=replace-with-your-maizey-api-token

# Same Neon Auth URL as above. Used to verify the sign-in token's signature.
NEON_AUTH_BASE_URL=replace-with-your-neon-auth-base-url

# Comma-separated browser origins allowed to call the Worker.
ALLOWED_ORIGINS=http://localhost:5173
